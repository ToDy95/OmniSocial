{
  "id": "omnisocialBatchFixture",
  "name": "SOC-011 · Manual finite six-account fixture",
  "active": false,
  "nodes": [
    {
      "id": "manual-finite-start",
      "name": "Manual finite start",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {}
    },
    {
      "id": "read-fixed-batch",
      "name": "Read fixed batch",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "url": "http://127.0.0.1:8787/v1/fixture/batch",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 5000,
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "omnisocialWorker",
          "name": "OmniSocial local worker"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "safe-synthetic-batch?",
      "name": "Safe synthetic batch?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "safe",
              "leftValue": "={{ $json.status === 'batch_fixture_ready' && $json.synthetic === true && $json.publishingEnabled === false && $json.sourceConnected === false && $json.report.requested === 12 }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "fixed-accounts",
      "name": "Fixed accounts",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        720,
        -100
      ],
      "parameters": {
        "fieldToSplitOut": "accounts",
        "include": "noOtherFields",
        "options": {
          "destinationFieldName": "account"
        }
      }
    },
    {
      "id": "one-account-at-a-time",
      "name": "One account at a time",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        960,
        -100
      ],
      "parameters": {
        "batchSize": 1,
        "options": {}
      }
    },
    {
      "id": "run-account-child",
      "name": "Run account child",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.3,
      "position": [
        1200,
        0
      ],
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "value": "omnisocialAccountFixture",
          "mode": "list"
        },
        "mode": "once",
        "options": {
          "waitForSubWorkflow": true
        }
      }
    },
    {
      "id": "account-validated?",
      "name": "Account validated?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1440,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "safe",
              "leftValue": "={{ $json.status === 'dry_run_validated' && $json.synthetic === true && $json.publishingEnabled === false }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "collect-fixture-rows",
      "name": "Collect fixture rows",
      "type": "n8n-nodes-base.aggregate",
      "typeVersion": 1,
      "position": [
        1200,
        -200
      ],
      "parameters": {
        "aggregate": "aggregateAllItemData",
        "destinationFieldName": "results",
        "options": {}
      }
    },
    {
      "id": "finite-fixture-report",
      "name": "Finite fixture report",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1440,
        -200
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "result",
              "name": "result",
              "value": "={{ $json.results.length === 12 && $json.results.every(r => r.status === 'dry_run_validated') ? 'batch_fixture_completed' : 'batch_fixture_blocked' }}",
              "type": "string"
            },
            {
              "id": "validated",
              "name": "validated",
              "value": "={{ $json.results.length }}",
              "type": "number"
            },
            {
              "id": "mode",
              "name": "mode",
              "value": "dry_run",
              "type": "string"
            },
            {
              "id": "synthetic",
              "name": "synthetic",
              "value": true,
              "type": "boolean"
            },
            {
              "id": "publishingEnabled",
              "name": "publishingEnabled",
              "value": false,
              "type": "boolean"
            },
            {
              "id": "submitted",
              "name": "submitted",
              "value": 0,
              "type": "number"
            },
            {
              "id": "verifiedPublic",
              "name": "verifiedPublic",
              "value": 0,
              "type": "number"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      }
    },
    {
      "id": "batch-blocked",
      "name": "Batch blocked",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        720,
        240
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "result",
              "name": "result",
              "value": "batch_fixture_blocked",
              "type": "string"
            },
            {
              "id": "publishingEnabled",
              "name": "publishingEnabled",
              "value": false,
              "type": "boolean"
            },
            {
              "id": "mode",
              "name": "mode",
              "value": "dry_run",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": false,
        "options": {}
      }
    }
  ],
  "connections": {
    "Manual finite start": {
      "main": [
        [
          {
            "node": "Read fixed batch",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read fixed batch": {
      "main": [
        [
          {
            "node": "Safe synthetic batch?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Safe synthetic batch?": {
      "main": [
        [
          {
            "node": "Fixed accounts",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Batch blocked",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fixed accounts": {
      "main": [
        [
          {
            "node": "One account at a time",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "One account at a time": {
      "main": [
        [
          {
            "node": "Collect fixture rows",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Run account child",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run account child": {
      "main": [
        [
          {
            "node": "Account validated?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Account validated?": {
      "main": [
        [
          {
            "node": "One account at a time",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Batch blocked",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Collect fixture rows": {
      "main": [
        [
          {
            "node": "Finite fixture report",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveExecutionProgress": false,
    "saveManualExecutions": false,
    "saveDataSuccessExecution": "none",
    "saveDataErrorExecution": "none",
    "executionTimeout": 120,
    "callerPolicy": "workflowsFromSameOwner"
  },
  "pinData": {},
  "tags": []
}
